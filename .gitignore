# ---------------------------------------------------------------- Python 运行时
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# ---------------------------------------------------------------- 环境（uv 管）
# uv 生成的虚拟环境不入库；uv.lock 与 .python-version 必须入库。
.venv/
venv/
.conda/

# ---------------------------------------------------------------- 打包 / 构建
build/
dist/
*.egg-info/
.eggs/
wheels/

# ---------------------------------------------------------------- 实验产物
# runs/<时间>_<名字>/ 里有 model.pt 与图，体积大且能重跑，不入库。
# 想留档某次实验就单独 git add -f runs/<目录>/summary.md。
runs/

# 旧 notebook 导出的提交材料目录（工具链已不含导出功能，防止误提交）
提交材料/

# ---------------------------------------------------------------- 输入图片
# my_images/ 放自己的手绘图与照片：保留占位说明，其他图片不入库。
my_images/*
!my_images/*.txt

# ---------------------------------------------------------------- 工具缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.cache/

# ---------------------------------------------------------------- Jupyter 残骸
# 已移除 notebook，仅防止误生成
.ipynb_checkpoints/

# ---------------------------------------------------------------- 编辑器 / 系统
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- 本地杂项
*.log
*.tmp
*.bak
.env
.env.*
